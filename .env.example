# Copy to .env and fill what you need (Daft and/or Adverts).
# Gitignored — never commit real tokens.

# Keycloak client id (Android app: daft-android-v2).
# DAFT_CLIENT_ID=daft-android-v2

# Per-agent Daft sessions (refresh/access keyed by agentId). Gitignored.
# Agent handshake: auth_login({ agentId, username, password }) — password never stored here.
# DAFT_AGENT_SESSIONS_FILE=F:/aiprojects/daft.ie/.daft-agent-sessions.json

# MCP agent auth: do NOT put DAFT_USERNAME / DAFT_PASSWORD in env.
# Pass them on auth_login; later tools use agentId only.

# reCAPTCHA for send_enquiry via LSPosed TCP on the phone (Tailscale).
# Phone: galaxy-j7 (100.83.27.97), module listens 0.0.0.0:17373.
# When set, @daft-ie/api sendMessage mints captcha automatically (MCP has no captcha args).
# DAFT_RECAPTCHA_TCP_HOST=galaxy-j7
# DAFT_RECAPTCHA_TCP_PORT=17373
# DAFT_RECAPTCHA_ACTION=enquiry_form_submit
# DAFT_RECAPTCHA_TCP_TIMEOUT_MS=90000

# --- Adverts.ie (@adverts-ie/api) — fresh API new.api.adverts.ie ---
# Client keys from Android ApiConstants (required for AdvertsApi).
# ADVERTS_NEW_API_KEY=...
# ADVERTS_OLD_API_KEY=...
# ADVERTS_ACCESS_TOKEN=...
# ADVERTS_USERNAME=user@example.com
# ADVERTS_PASSWORD=your-password
# Login may require X-Recaptcha-Token (Android sends one).
# After auth_login, token is saved to .adverts-tokens.json (gitignored).
# Override path with:
# ADVERTS_TOKEN_FILE=F:/aiprojects/daft.ie/.adverts-tokens.json

# Fastify MCP host (@daft-ie/mcp-host)
# MCP_HOST=127.0.0.1
# MCP_HOST_PORT=3100

# Claude.ai custom connectors need OAuth 2.1 + DCR on the public host.
# Set MCP_PUBLIC_URL to the HTTPS origin users enter (no trailing slash).
# MCP_PUBLIC_URL=https://dmcp.delt.io
# MCP_OAUTH=1
# MCP_OAUTH_STORE=/data/oauth-store.json
# MCP_OAUTH_CLIENT_ID=claude-mcp
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_AUTO_APPROVE=1
# MCP_OAUTH_PASSWORD=
# Optional long-lived Bearer keys for Cursor/Hermes (comma-separated):
# MCP_API_KEYS=change-me

# Optional HTTP proxy (local/dev). Docker+Tailscale sets this itself — leave unset.
# HTTP_PROXY=http://user:pass@host:port

# Docker mcp-host Tailscale (userspace → Pi exit node 100.86.200.43)
# TS_AUTHKEY=tskey-auth-...

