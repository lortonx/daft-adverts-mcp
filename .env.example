# Copy this file to .env and fill in your Daft.ie credentials.
# The .env file is gitignored — never commit real tokens.

# Daft.ie account credentials (only works for accounts with a Keycloak
# password; Google/Apple SSO accounts cannot use password login).
# DAFT_USERNAME=user@example.com
# DAFT_PASSWORD=your-password

# A refresh token obtained from the Daft.ie Android app or website.
# Used to mint short-lived access tokens (expires in ~5 minutes).
# When passed to the client it also enables automatic 401 rotation.
# DAFT_REFRESH_TOKEN=your-refresh-token

# Optional: already-valid access token (skips refresh entirely).
# DAFT_ACCESS_TOKEN=eyJ...

# After auth_login / token rotation, tokens are saved to .daft-tokens.json
# (gitignored) and preferred over DAFT_* on next start. Override path with:
# DAFT_TOKEN_FILE=F:/aiprojects/daft.ie/.daft-tokens.json

# Fastify MCP host (@daft-ie/mcp-host)
# MCP_HOST=127.0.0.1
# MCP_HOST_PORT=3100
