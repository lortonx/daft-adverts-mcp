# Copy to .env and fill what you need (Daft and/or Adverts).
# Gitignored — never commit real tokens.

# Keycloak client id (Android app: daft-android-v2). Required for DaftApi.
# DAFT_CLIENT_ID=daft-android-v2

# Daft.ie account credentials (only works for accounts with a Keycloak
# password; Google/Apple SSO accounts cannot use password login).
# DAFT_USERNAME=user@example.com
# DAFT_PASSWORD=your-password

# A refresh token obtained from the Daft.ie Android app or website.
# Used to mint short-lived access tokens (expires in ~5 minutes).
# When passed to the client it also enables automatic 401 rotation.
# DAFT_REFRESH_TOKEN=your-refresh-token

# Optional: already-valid access token (skips refresh entirely).
# DAFT_ACCESS_TOKEN=eyJ...

# After auth_login / token rotation, tokens are saved to .daft-tokens.json
# (gitignored) and preferred over DAFT_* on next start. Override path with:
# DAFT_TOKEN_FILE=F:/aiprojects/daft.ie/.daft-tokens.json

# --- Adverts.ie (@adverts-ie/api) — fresh API new.api.adverts.ie ---
# Client keys from Android ApiConstants (required for AdvertsApi).
# ADVERTS_NEW_API_KEY=...
# ADVERTS_OLD_API_KEY=...
# ADVERTS_ACCESS_TOKEN=...
# ADVERTS_USERNAME=user@example.com
# ADVERTS_PASSWORD=your-password
# Login may require X-Recaptcha-Token (Android sends one).
# After auth_login, token is saved to .adverts-tokens.json (gitignored).
# Override path with:
# ADVERTS_TOKEN_FILE=F:/aiprojects/daft.ie/.adverts-tokens.json

# Fastify MCP host (@daft-ie/mcp-host)
# MCP_HOST=127.0.0.1
# MCP_HOST_PORT=3100

# Optional HTTP proxy (local/dev). Docker+Tailscale sets this itself — leave unset.
# HTTP_PROXY=http://user:pass@host:port

# Docker mcp-host Tailscale (userspace → Pi exit node 100.86.200.43)
# TS_AUTHKEY=tskey-auth-...

