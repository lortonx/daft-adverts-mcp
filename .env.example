# Copy to .env and fill what you need (Daft and/or Adverts).
# Gitignored — never commit real tokens.

# Local/diag scripts only (diagnose-enquiry-403, probe-*). Not used by MCP tools —
# agents pass username/password on auth_login, or use refresh tokens below.
# DAFT_USERNAME=you@example.com
# DAFT_PASSWORD=

# Optional session tokens (scripts / boot). Prefer refresh over password long-term.
# DAFT_REFRESH_TOKEN=
# DAFT_ACCESS_TOKEN=

# Keycloak client id (Android app: daft-android-v2).
# DAFT_CLIENT_ID=daft-android-v2

# Per-agent Daft sessions (refresh/access keyed by agentId). Gitignored.
# Agent handshake: auth_login({ agentId, username, password }) — password never stored here.
# DAFT_AGENT_SESSIONS_FILE=F:/aiprojects/daft.ie/.daft-agent-sessions.json

# Enquiry: Chrome web form only (phone LSPosed TCP mint removed).
# DAFT_ENQUIRY_MODE=chrome
#
# Chrome pool (set in Dockerfile):
# CHROME_PATH=/usr/bin/google-chrome-stable
# DAFT_CHROME_XVFB=1
# DAFT_CHROME_DISPLAY=:99
# DAFT_CHROME_DATA_DIR=/data/daft-chrome
# DAFT_CHROME_IDLE_MS=90000
# DAFT_CHROME_DEBUG_PORT=9339
# Attach to host Chrome on a real display (skips spawn/Xvfb). Needed when CF blocks Docker Chrome.
# DAFT_CHROME_CDP_URL=http://10.0.1.1:9222

# Wipe Chrome --user-data-dir after idle kill (cookies stay in cookies/*.json):
# DAFT_CHROME_WIPE_PROFILE=1
# Drop cookie JSON unused longer than this (ms); default 30d; 0 = never:
# DAFT_CHROME_COOKIE_MAX_AGE_MS=2592000000
#
# Optional Bun HTTP proxy for search/API (not used by Chrome):
# HTTP_PROXY=http://user:pass@host:port
# DAFT_HTTP_TIMEOUT_MS=30000

# --- Adverts.ie (@adverts-ie/api) — fresh API new.api.adverts.ie ---
# Client keys from Android ApiConstants (required for AdvertsApi).
# ADVERTS_NEW_API_KEY=...
# ADVERTS_OLD_API_KEY=...
# ADVERTS_ACCESS_TOKEN=...
# ADVERTS_USERNAME=user@example.com
# ADVERTS_PASSWORD=your-password
# Login may require X-Recaptcha-Token (Android sends one).
# After auth_login, token is saved to .adverts-tokens.json (gitignored).
# Override path with:
# ADVERTS_TOKEN_FILE=F:/aiprojects/daft.ie/.adverts-tokens.json

# Fastify MCP host (@daft-ie/mcp-host)
# MCP_HOST=127.0.0.1
# MCP_HOST_PORT=3100

# Claude.ai custom connectors need OAuth 2.1 + DCR on the public host.
# Set MCP_PUBLIC_URL to the HTTPS origin users enter (no trailing slash).
# Also used as the Host allowlist when MCP_HOST=0.0.0.0.
# MCP_PUBLIC_URL=https://example.com
# MCP_OAUTH=1
# MCP_OAUTH_STORE=/data/oauth-store.json
# MCP_OAUTH_CLIENT_ID=claude-mcp
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_AUTO_APPROVE=1
# MCP_OAUTH_PASSWORD=
# Optional long-lived Bearer keys for Cursor/Hermes (comma-separated):
# MCP_API_KEYS=change-me

# Optional Bun HTTP proxy for search/API (not used by Chrome enquiry):
# HTTP_PROXY=http://user:pass@host:port

